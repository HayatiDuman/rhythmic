<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.app.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:padding="24dp">

    <!-- Sürükleme Tutamacı -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="?attr/colorOutline"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Oynatma Listesine Ekle"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginBottom="16dp"/>

    <!-- Yeni Liste Oluşturma Satırı -->
    <LinearLayout
        android:id="@+id/btnDialogCreateNewPlaylist"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_input_add"
            app:tint="?attr/colorSecondary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yeni Oynatma Listesi Oluştur"
            android:layout_marginStart="16dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorSecondary"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline"
        android:layout_marginVertical="12dp"/>

    <!-- Mevcut Listelerin Sergileneceği Yer -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDialogPlaylists"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:scrollbars="vertical"/>

</LinearLayout>