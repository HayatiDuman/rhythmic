<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="5dp"
    android:background="#F5F5F5">

    <EditText
        android:id="@+id/etArama"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Şarkı veya sanatçı ara..."
        android:background="@android:drawable/edit_text"
        android:paddingStart="12dp"
        android:layout_marginEnd="0dp"
        android:singleLine="true"
        android:imeOptions="actionSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnAra"
        app:layout_constraintTop_toTopOf="parent"/>

    <Button
        android:id="@+id/btnAra"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:text="ARA"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tvDurum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Arama yapmak için yazın"
        android:gravity="center"
        android:textColor="#555555"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/etArama"/>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDurum"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvListe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvDurum"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>