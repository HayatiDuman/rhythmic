<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"> <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="?android:attr/windowBackground"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/imgInfoKapak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_gallery" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvInfoBaslik"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Şarkı Adı"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?android:attr/windowBackground"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvInfoKanal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kanal: ..."
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvInfoSure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Süre: ..."
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvInfoBoyut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tahmini Boyut: ..."
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="12dp"/>

        <ProgressBar
            android:id="@+id/pbInfoLoading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvInfoIzlenme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Görüntülenme: Yükleniyor..."
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="8dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvInfoBegeni"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Beğeni: Yükleniyor..."
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="8dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvInfoTarih"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yayınlanma: Yükleniyor..."
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="12dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvInfoAciklama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Açıklama: Yükleniyor..."
            android:textSize="12sp"
            android:textColor="?android:attr/textColorHint"
            android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
</ScrollView>